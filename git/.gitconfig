[user]
    name = Krrish Dang
    email = krrishdang@gmail.com

[pull]
    rebase = true

[rebase]
    autoStash = true

[init]
    defaultBranch = main

[push]
    default = simple

[alias]
    st = status
    co = checkout
    br = branch
    aa = add .
    cm = commit -m
    lg = log --oneline --graph --all --decorate
    sync = "!git pull --rebase && git push"
    undo = reset --soft HEAD~1