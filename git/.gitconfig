[user]
    name = Krrish Dang
    email = krrishdang@gmail.com

[pull]
    rebase = true

[rebase]
    autoStash = true

[init]
    defaultBranch = main

[push]
    default = simple

[alias]
    # Basic
    st = status
    co = checkout
    br = branch

    # Add / commit
    aa = add .
    cm = commit -m

    # Log (VERY IMPORTANT)
    lg = log --oneline --graph --all --decorate

    # Sync
    sync = "!git pull --rebase && git push"

    # Undo last commit (keep changes)
    undo = reset --soft HEAD~1

    # Clean merged branches
    clean = "!git branch --merged | grep -v '\\*\\|main' | xargs -n 1 git branch -d"