{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "padding": {
      "top": 1,
      "right": 4,
    },
    "color": {
      "1": "#F5E0DC",
      "2": "#F2CDCD",
      "3": "#F5C2E7",
      "4": "#FAB387",
      "5": "#F9E2AF",
      "6": "#A6E3A1",
      "7": "#94E2D5",
      "8": "#89DCEB",
      "9": "#74C7EC",
    },
  },

  "display": {
    "separator": "   ",
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#F5C2E7",
        "at": "#BAC2DE",
        "host": "#89DCEB",
      },
    },

    "break",

    {
      "type": "os",
      "key": "OS",
      "keyColor": "#89DCEB",
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#89DCEB",
    },

    "break",

    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#F5C2E7",
    },

    "break",

    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#A6E3A1",
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#94E2D5",
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
