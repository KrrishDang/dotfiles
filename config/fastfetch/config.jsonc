{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "color": {
      "1": "#F5E0DC",
      "2": "#F2CDCD",
      "3": "#F5C2E7",
      "4": "#FAB387",
      "5": "#F9E2AF",
      "6": "#A6E3A1",
      "7": "#94E2D5",
      "8": "#89DCEB",
      "9": "#74C7EC",
    },
    "padding": {
      "top": 1,
      "right": 4,
    },
  },

  "display": {
    "separator": "   ",
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#F5C2E7",
        "at": "#CDD6F4",
        "host": "#89DCEB",
      },
    },

    "break",

    {
      "type": "os",
      "key": "  OS",
      "keyColor": "#89DCEB",
    },
    {
      "type": "host",
      "key": "󰌢  Host",
      "keyColor": "#89DCEB",
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "keyColor": "#89DCEB",
    },
    {
      "type": "packages",
      "key": "󰏖  Packages",
      "keyColor": "#89DCEB",
    },
    {
      "type": "uptime",
      "key": "󰔛  Uptime",
      "keyColor": "#89DCEB",
    },

    "break",

    {
      "type": "shell",
      "key": "󰆍  Shell",
      "keyColor": "#F5C2E7",
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "#F5C2E7",
    },

    "break",

    {
      "type": "cpu",
      "key": "  CPU",
      "keyColor": "#FAB387",
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU",
      "keyColor": "#FAB387",
    },
    {
      "type": "memory",
      "key": "  Memory",
      "keyColor": "#A6E3A1",
      "format": "{used} / {total} ({percentage})",
    },

    "break",

    {
      "type": "localip",
      "key": "󰩠  IP",
      "keyColor": "#F9E2AF",
    },
    {
      "type": "battery",
      "key": "󰁹  Battery",
      "keyColor": "#A6E3A1",
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
