# ==================================================
# User
# ==================================================

[user]
    name = Krrish Dang
    email = 153355802+KrrishDang@users.noreply.github.com

# ==================================================
# Core
# ==================================================

[core]
    editor = nvim
    excludesfile = ~/.config/git/.gitignore_global
    autocrlf = input
    pager = delta

# ==================================================
# Default Branch
# ==================================================

[init]
    defaultBranch = main

# ==================================================
# Pull / Push
# ==================================================

[pull]
    rebase = true

[rebase]
    autoStash = true
    updateRefs = true

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[fetch]
    prune = true

# ==================================================
# Merge / Diff
# ==================================================

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[rerere]
    enabled = true

# ==================================================
# Credential
# ==================================================

[credential]
    helper = store

# ==================================================
# Aliases
# ==================================================

[alias]

    # Status
    st = status -sb

    # Add
    a = add
    aa = add --all

    # Commit
    c = commit
    cm = commit -m
    ca = commit --amend

    # Branching
    sw = switch
    co = checkout
    br = branch

    # Logs
    lg = log --graph --decorate --oneline --all
    last = log -1 HEAD

    # Diff
    df = diff

    # Restore
    unstage = restore --staged

    # Rebase
    rb = rebase

    # Sync
    sync = "!git pull --rebase && git push"

    # Undo last commit (keep changes)
    undo = reset --soft HEAD~1

    # Clean merged branches
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -r git branch -d"

# ==================================================
# Colors
# ==================================================

[color]
    ui = auto

# ==================================================
# Delta
# ==================================================

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[interactive]
    diffFilter = delta --color-only
